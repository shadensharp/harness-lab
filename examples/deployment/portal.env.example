# Core paths
PORTAL_APP_ROOT=/srv/repo-harness-lab/app
PORTAL_PYTHON_BIN=/srv/repo-harness-lab/app/.venv/bin/python
REPO_HARNESS_LAB_PROJECT_ROOT=/srv/repo-harness-lab/app
REPO_HARNESS_LAB_RUNTIME_ROOT=/srv/repo-harness-lab/runtime
