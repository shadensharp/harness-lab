{
  "suite_id": "openai-provider-multi-signal-uplift-suite",
  "notes": [
    "同一模型在 current 与 custom 运行配置下的多信号 provider 对照片段",
    "第一题主要展示 repo_context，第二题主要展示 task_inputs 与 verifier_plan",
    "需要设置环境变量：OPENAI_API_KEY=你的_API_KEY，OPENAI_BASE_URL=你的_中转地址"
  ],
  "cases": [
    {
      "case_id": "readme-title-sync",
      "task_spec_ref": "../tasks/requirement_change/qwen_provider_readme_uplift_task.json",
      "notes": [
        "同一模型、同一任务、只切换运行配置",
        "repo_context 信号应让 current 明显强于 custom"
      ],
      "run_matrix": [
        {
          "label": "openai-current",
          "harness_profile": "current",
          "request": {
            "agent_profile": {
              "name": "gpt-4",
              "provider": "openai",
              "metadata": {
                "model": "gpt-5.1",
                "api_key_env": "OPENAI_API_KEY"
              }
            }
          }
        },
        {
          "label": "openai-custom",
          "harness_profile": "custom",
          "request": {
            "agent_profile": {
              "name": "gpt-4",
              "provider": "openai",
              "metadata": {
                "model": "gpt-5.1",
                "api_key_env": "OPENAI_API_KEY",
                "include_inputs": false,
                "include_verifier_plan": false,
                "max_context_files": 4,
                "max_file_chars": 4000
              }
            }
          }
        }
      ]
    },
    {
      "case_id": "release-input-sync",
      "task_spec_ref": "../tasks/requirement_change/qwen_provider_release_input_uplift_task.json",
      "notes": [
        "同一模型、同一任务、只切换运行配置",
        "任务输入与 verifier 信号应让 current 明显强于 custom"
      ],
      "run_matrix": [
        {
          "label": "openai-current",
          "harness_profile": "current",
          "request": {
            "agent_profile": {
              "name": "gpt-4",
              "provider": "openai",
              "metadata": {
                "model": "gpt-5.1",
                "api_key_env": "OPENAI_API_KEY"
              }
            }
          }
        },
        {
          "label": "openai-custom",
          "harness_profile": "custom",
          "request": {
            "agent_profile": {
              "name": "gpt-4",
              "provider": "openai",
              "metadata": {
                "model": "gpt-5.1",
                "api_key_env": "OPENAI_API_KEY",
                "include_inputs": false,
                "include_verifier_plan": false,
                "max_context_files": 4,
                "max_file_chars": 4000
              }
            }
          }
        }
      ]
    }
  ]
}
